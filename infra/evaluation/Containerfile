ARG BASE_IMAGE=docker.io/library/eclipse-temurin:21.0.8_9-jdk-jammy
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG TARGETARCH
ARG NODE_VERSION=22.19.0
ARG NODE_SHA256_AMD64=c0649af18e6a24f6fe5535a3e86b341dd49a8e71117c8b68bde973ef834f16f2
ARG NODE_SHA256_ARM64=0b2d9f564b6594222a62c82e1df2efe119dd4a4aff29644f4dd325bf360b6bcc
ARG SOURCE_REVISION=unknown
ARG SOURCE_TREE_HASH=unknown

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH}" in \
        amd64) node_arch=x64; node_sha="${NODE_SHA256_AMD64}" ;; \
        arm64) node_arch=arm64; node_sha="${NODE_SHA256_ARM64}" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${archive}" \
    && echo "${node_sha}  ${archive}" | sha256sum --check --strict \
    && tar -xJf "${archive}" -C /usr/local --strip-components=1 \
    && rm "${archive}" \
    && node --version \
    && npm --version

WORKDIR /opt/swarm-source
COPY . .

RUN npm --prefix pi-0.80.10 ci --ignore-scripts \
    && ./gradlew :backend:testClasses :desktopApp:testClasses --no-daemon \
    && mkdir -p /opt/swarm-cache/gradle /opt/swarm-cache/wrapper /opt/swarm-cache/npm \
    && cp -a /root/.gradle/caches/modules-2 /opt/swarm-cache/gradle/ \
    && cp -a /root/.gradle/wrapper/dists /opt/swarm-cache/wrapper/ \
    && cp -a /root/.npm/_cacache /opt/swarm-cache/npm/ \
    && find /opt/swarm-cache/gradle -type f \( -name '*.lock' -o -name 'gc.properties' \) -delete \
    && chmod -R a+rX /opt/swarm-cache \
    && rm -rf /opt/swarm-source /root/.gradle /root/.npm

COPY --chmod=755 infra/evaluation/entrypoint.sh /usr/local/bin/swarm-eval-entrypoint

ENV GRADLE_RO_DEP_CACHE=/opt/swarm-cache/gradle \
    GRADLE_USER_HOME=/tmp/.gradle \
    npm_config_audit=false \
    npm_config_cache=/tmp/.npm \
    npm_config_fund=false \
    npm_config_offline=true \
    npm_config_update_notifier=false

LABEL org.opencontainers.image.title="Swarm Editor isolated evaluator" \
    org.opencontainers.image.revision="${SOURCE_REVISION}" \
    io.swarmeditor.source-tree-sha256="${SOURCE_TREE_HASH}" \
    io.swarmeditor.node-version="${NODE_VERSION}"

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/swarm-eval-entrypoint"]
